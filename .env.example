# ModelScope 访问凭证（可选，用于云端文生图/图生图；也可在管理后台账号中心填写）
MODELSCOPE_API_TOKEN=

# 自建免费渠道（可选，由你自行提供；留空则不启用，走默认免费源）
# 需为 OpenAI 兼容接口，BASE_URL 需含版本前缀，例如 https://api.example.com/v1
USER_DIDI_MEDIA_BASE_URL=
USER_DIDI_MEDIA_API_KEY=
USER_DIDI_MEDIA_MODEL_ID=
USER_DIDI_MEDIACUT_BASE_URL=
USER_DIDI_MEDIACUT_API_KEY=
USER_DIDI_MEDIACUT_MODEL_ID=

# 管理后台账号（生产环境务必修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥（生产环境务必修改为强随机值，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-in-production-please-set-a-strong-secret

# 允许跨域来源，逗号分隔；同域部署可保持默认 *
ALLOWED_ORIGINS=*

# 数据库连接（留空使用 backend/media.db）
DATABASE_URL=

# 语音识别模型规格：tiny / base / small / medium
WHISPER_MODEL=small

# ModelScope 模型（可选覆盖）
# MODELSCOPE_MATTING_MODEL=damo/cv_unet_image-matting
# MODELSCOPE_ENHANCE_MODEL=damo/cv_dfdnet_image_enhance
# MODELSCOPE_ASR_MODEL=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
# MODELSCOPE_TTS_MODEL=damo/speech_sambert-hifigan_tts_zh-cn-16k
