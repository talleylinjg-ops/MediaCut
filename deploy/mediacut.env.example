# MediaCut API 生产环境变量示例
# 部署后位于 /etc/mediacut/mediacut.env，权限 600

# ModelScope 访问凭证（可选，用于云端文生图/图生图；也可在管理后台账号中心填写）
MODELSCOPE_API_TOKEN=

# 自建免费渠道（可选；留空则不启用，改用 Pollinations/ModelScope 默认路由）
# 需为 OpenAI 兼容接口：{BASE_URL}/images/generations、{BASE_URL}/images/edits、{BASE_URL}/chat/completions
# BASE_URL 需包含版本前缀，例如 https://api.example.com/v1
USER_DIDI_MEDIA_BASE_URL=
USER_DIDI_MEDIA_API_KEY=
USER_DIDI_MEDIA_MODEL_ID=
USER_DIDI_MEDIACUT_BASE_URL=
USER_DIDI_MEDIACUT_API_KEY=
USER_DIDI_MEDIACUT_MODEL_ID=

# 管理员账号（务必修改默认密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# JWT 密钥（务必改为强随机值，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-this-secret

# 允许跨域来源，逗号分隔；同域部署可留 *. 多个域名示例：https://a.com,https://b.com
ALLOWED_ORIGINS=https://didimedia.com

# 数据库连接（留空使用 backend/media.db）
DATABASE_URL=

# 语音识别模型规格：tiny / base / small / medium（越大越准、越耗内存）
WHISPER_MODEL=small
